# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google sign-in
GOOGLE_CLIENT_ID=

# PDF uploads
MAX_UPLOAD_MB=20

# Seed built-in books, Bible books and admin configuration on every server start
AUTO_SEED=true
